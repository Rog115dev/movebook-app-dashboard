# Admin CMS login
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=change-me-admin-secret

# Mobile JWT
MOBILE_JWT_SECRET=change-me-mobile-jwt-secret

# MongoDB (mobile users)
MONGODB_URI=mongodb://127.0.0.1:27017/fitai-coach

# IMPORTANT for VPS / public IP access:
# - Do NOT set HOST or HOSTNAME to "23.x.x.x:3001" (causes redirect loops).
# - Start with: npm run start  (uses -H 0.0.0.0 -p 3001)
# - Open: http://YOUR_IP:3001  (must include http://)
